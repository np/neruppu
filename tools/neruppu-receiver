#!/usr/bin/env python3
"""neruppu-receiver: minimal endpoint for Neruppu's HTTPS webhook transport.

Stores every POST under OUTDIR as files plus a JSON line in OUTDIR/alerts.jsonl.
Captures arrive as age blobs: decrypt them with `neruppu-decrypt` / `age -d`.

    neruppu-receiver --port 8080 --out ./alerts --token "$TOKEN"

It speaks plain HTTP: put it behind a TLS-terminating reverse proxy (Caddy,
nginx, a tunnel...). The app refuses non-https endpoints.

Stdlib only. Wire format: docs/https-transport.md.
"""

import argparse
import hmac
import json
import os
import re
import sys
import time
from email.parser import BytesParser
from email.policy import HTTP
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

MAX_BODY = 64 * 1024 * 1024
SAFE_NAME = re.compile(r"^[0-9A-Za-z][0-9A-Za-z._-]{0,100}$")


def parse_multipart(content_type, body):
    msg = BytesParser(policy=HTTP).parsebytes(
        b"Content-Type: " + content_type.encode("latin-1") + b"\r\n\r\n" + body
    )
    if not msg.is_multipart():
        raise ValueError("expected multipart/form-data")
    fields, files = {}, []
    for part in msg.iter_parts():
        name = part.get_param("name", header="content-disposition")
        filename = part.get_filename()
        data = part.get_payload(decode=True) or b""
        if filename is not None:
            files.append((name, filename, part.get_content_type(), data))
        elif name:
            fields[name] = data.decode("utf-8", "replace")
    return fields, files


class Handler(BaseHTTPRequestHandler):
    server_version = "neruppu-receiver"
    sys_version = ""

    def _reply(self, code, text):
        body = (text + "\n").encode()
        self.send_response(code)
        self.send_header("Content-Type", "text/plain; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_POST(self):
        cfg = self.server.cfg
        if cfg.token:
            got = self.headers.get("Authorization", "")
            if not hmac.compare_digest(got.encode(), ("Bearer " + cfg.token).encode()):
                return self._reply(401, "unauthorized")

        length = int(self.headers.get("Content-Length") or 0)
        if length <= 0 or length > MAX_BODY:
            return self._reply(413 if length > MAX_BODY else 411, "bad length")
        body = self.rfile.read(length)

        try:
            fields, files = parse_multipart(self.headers.get("Content-Type", ""), body)
        except ValueError as e:
            return self._reply(400, str(e))

        kind = fields.get("kind", "")
        record = {
            "received": int(time.time() * 1000),
            "kind": kind,
            "timestamp": fields.get("timestamp"),
            "message": fields.get("message"),
            "files": [],
        }
        for _name, filename, ctype, data in files:
            base = os.path.basename(filename)
            if not SAFE_NAME.match(base):
                return self._reply(400, "bad filename")
            path = os.path.join(cfg.out, base)
            # Never overwrite: a retried upload gets a suffix.
            n = 1
            while os.path.exists(path):
                path = os.path.join(cfg.out, f"{base}.{n}")
                n += 1
            with open(path, "xb") as f:
                f.write(data)
            record["files"].append({"name": os.path.basename(path), "type": ctype, "size": len(data)})

        with open(os.path.join(cfg.out, "alerts.jsonl"), "a", encoding="utf-8") as log:
            log.write(json.dumps(record, ensure_ascii=False) + "\n")
        print(json.dumps(record, ensure_ascii=False), file=sys.stderr, flush=True)
        return self._reply(200, "ok")

    def log_message(self, fmt, *args):
        pass  # one JSON line per alert is printed instead


def main():
    p = argparse.ArgumentParser(prog="neruppu-receiver", description=__doc__.split("\n")[0])
    p.add_argument("--bind", default="127.0.0.1")
    p.add_argument("--port", type=int, default=8080)
    p.add_argument("--out", default="neruppu-alerts")
    p.add_argument("--token", default=os.environ.get("NERUPPU_TOKEN", ""),
                   help="required bearer token (default: $NERUPPU_TOKEN; empty = none)")
    cfg = p.parse_args()
    os.makedirs(cfg.out, mode=0o700, exist_ok=True)

    server = ThreadingHTTPServer((cfg.bind, cfg.port), Handler)
    server.cfg = cfg
    print(f"listening on http://{cfg.bind}:{cfg.port}, storing in {cfg.out}", file=sys.stderr)
    server.serve_forever()


if __name__ == "__main__":
    main()
